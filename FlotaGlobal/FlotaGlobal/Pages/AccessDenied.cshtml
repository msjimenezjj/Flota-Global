@page
@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container mt-5 text-center" style="max-width: 500px;">
    <div class="card shadow-sm border-danger p-4">
        <h1 class="display-4 text-danger">🚫</h1>
        <h3 class="fw-bold text-danger">Acceso Denegado</h3>
        <p class="text-muted mt-2">
            Tu rol de usuario actual (<strong>Rol #@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong>)
            no tiene permisos para crear o modificar registros en esta sección.
        </p>
        <div class="mt-4">
            <a asp-page="/Vehiculos" class="btn btn-primary px-4">Volver a Vehículos</a>
        </div>
    </div>
</div>
