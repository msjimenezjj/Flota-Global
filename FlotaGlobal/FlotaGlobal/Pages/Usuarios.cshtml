@page
@model FlotaGlobal.Pages.UsuariosModel
@{
    ViewData["Title"] = "Administración de Usuarios";
}

<div class="container mt-4">
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            ✅ @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold m-0"> Administración de Usuarios y Roles</h2>
            <span class="text-muted small">Panel exclusivo para Administradores del sistema</span>
        </div>
        <a asp-page="/UsuariosCrear" class="btn btn-dark fw-bold px-4 shadow-sm">+ Nuevo Usuario</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle m-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Nombre Completo</th>
                            <th>Correo de Acceso</th>
                            <th>Rol Asignado</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.ListaUsuarios)
                        {
                            var esActivo = u.Estado.ToUpper() == "A";
                            <tr>
                                <td class="ps-3 fw-bold text-muted">#@u.IdUsuario</td>
                                <td class="fw-bold text-dark">@u.Nombre</td>
                                <td>@u.Correo</td>
                                <td><span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2">@u.NombreRol</span></td>
                                <td class="text-center">
                                    <span class="badge @(esActivo ? "bg-success" : "bg-danger") px-3 py-2">
                                        @(esActivo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a asp-page="/UsuariosEditar" asp-route-id="@u.IdUsuario" class="btn btn-sm btn-outline-primary fw-bold px-3">Editar</a>

                                        @if (esActivo)
                                        {
                                            <form method="post" asp-page-handler="Inactivar" asp-route-id="@u.IdUsuario" onsubmit="return confirm('¿Deseas desactivar el acceso de este usuario?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Desactivar</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
