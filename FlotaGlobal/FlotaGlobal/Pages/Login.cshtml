@page
@model FlotaGlobal.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<style>
    body {
        background: linear-gradient(rgba(15, 23, 42, 0.82), rgba(15, 23, 42, 0.82)), url('/images/fondo-flota.jpg') no-repeat center center fixed;
        background-size: cover;
    }

    .card-empresarial {
        background-color: rgba(255, 255, 255, 0.96) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
    }

    .text-blanco-sombra {
        color: #ffffff;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);
    }
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card card-empresarial shadow-lg border-0" style="width: 100%; max-width: 420px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-primary">🚛 Flota Global</h3>
                <p class="text-muted small fw-bold">Gestión y Control de Operaciones</p>
            </div>

            <!-- Alerta de errores de autenticación -->
            @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
            {
                <div class="alert alert-danger p-2 small shadow-sm" role="alert">
                    ⚠️ @Model.ErrorMensaje
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Correo Electrónico</label>
                    <input type="email" asp-for="Correo" class="form-control border-secondary" placeholder="ejemplo@empresa.com" required autofocus />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Contraseña</label>
                    <input type="password" asp-for="Contrasena" class="form-control border-secondary" placeholder="••••••••" required />
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary fw-bold py-2 shadow">Ingresar al Sistema</button>
                </div>
                <div class="text-center mt-3">
                    <a asp-page="/ForgotPassword" class="text-decoration-none small fw-bold text-primary">¿Olvidó su contraseña?</a>
                </div>

            </form>
        </div>
    </div>
</div>
