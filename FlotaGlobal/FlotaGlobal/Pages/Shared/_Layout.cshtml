<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlotaGlobal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlotaGlobal.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- AQUÍ VA TODO EL BLOQUE NUEVO DEL MENÚ EN UNA SOLA LÍNEA -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-page="/Index">🚛 FlotaGlobal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <!-- Menú Izquierdo en una sola línea -->
                    <ul class="navbar-nav flex-grow-1 gap-1 small fw-semibold">
                        <li class="nav-item">
                            <a class="nav-link text-dark text-nowrap" asp-area="" asp-page="/Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark text-nowrap" asp-area="" asp-page="/Vehiculos">Vehículos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark text-nowrap" asp-area="" asp-page="/Conductores">Conductores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark text-nowrap" asp-area="" asp-page="/Rutas">Rutas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark text-nowrap" asp-area="" asp-page="/Programacion">Programación</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark text-nowrap" asp-area="" asp-page="/Mantenimientos">Mantenimientos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark text-nowrap" asp-area="" asp-page="/CombustibleGastos">Combustible y Gastos</a>
                        </li>
                        @if (User.IsInRole("1"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold text-nowrap" asp-area="" asp-page="/Usuarios">Usuarios</a>
                            </li>
                        }
                    </ul>

                    <!-- Menú Derecho sin saltos de línea -->
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="text-primary fw-bold small text-nowrap">👋 @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-danger fw-bold px-3 text-nowrap" asp-page="/Logout">Cerrar Sesión</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary fw-bold px-3 text-nowrap" asp-page="/Login">Iniciar Sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - FlotaGlobal - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
