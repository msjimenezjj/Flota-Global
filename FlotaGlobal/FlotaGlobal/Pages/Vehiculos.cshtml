@page
@model FlotaGlobal.Pages.VehiculosModel
@{
    ViewData["Title"] = "Listado de Vehículos";
}

<div class="container mt-4">
    <!-- CAMBIO 1: Encabezado modificado para incluir el título y el botón de registro alineados -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2> Control de Flota - Vehículos Registrados</h2>
        <a asp-page="/VehiculosCrear" class="btn btn-success">+ Registrar vehículo</a>
    </div>

    @if (Model.Vehiculos == null || !Model.Vehiculos.Any())
    {
        <div class="alert alert-warning shadow-sm" role="alert">
            🚩 <strong>Atención:</strong> No se encontraron vehículos registrados en la base de datos actualmente o la tabla está vacía.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover m-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Placa</th>
                                <th>Marca</th>
                                <th>Modelo</th>
                                <th>Año</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vehiculo in Model.Vehiculos)
                            {
                                <tr>
                                    <td class="fw-bold text-primary ps-3">@vehiculo.Placa</td>
                                    <td>@vehiculo.Marca</td>
                                    <td>@vehiculo.Modelo</td>
                                    <td>@vehiculo.Anio</td>
                                    <td class="text-center">
                                        <!-- CAMBIO 2: Línea del badge dinámica según el estado real de la base de datos -->
                                        <span class="badge @ClaseEstado(vehiculo.Estado) px-3 py-2">@TextoEstado(vehiculo.Estado)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string ClaseEstado(string? estado) => estado?.Trim().ToUpper() switch
    {
        "A" => "bg-success text-white",
        "DISPONIBLE" => "bg-success text-white",
        "M" => "bg-warning text-dark",
        "EN_MANTENIMIENTO" => "bg-warning text-dark",
        "INACTIVO" => "bg-danger text-white",
        "'INACTIVO'" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    string TextoEstado(string? estado) => (estado?.Trim().ToUpper()) switch
    {
        "A" => "Activo",
        "M" => "Mantenimiento",
        _ => (estado ?? "sin estado").Replace("_", " ").Replace("'", "")
    };
}

