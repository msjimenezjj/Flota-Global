@page
@model FlotaGlobal.Pages.VehiculosCrearModel
@{
    ViewData["Title"] = "Registrar vehículo";
}

<div class="container mt-4" style="max-width: 640px;">
    <h2 class="mb-4">Registrar vehículo</h2>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="Vehiculo.Placa" class="form-label">Placa</label>
            <input asp-for="Vehiculo.Placa" class="form-control" />
            <span asp-validation-for="Vehiculo.Placa" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Vehiculo.NumeroInterno" class="form-label">Número interno</label>
            <input asp-for="Vehiculo.NumeroInterno" class="form-control" />
            <span asp-validation-for="Vehiculo.NumeroInterno" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Vehiculo.Marca" class="form-label">Marca</label>
            <input asp-for="Vehiculo.Marca" class="form-control" />
            <span asp-validation-for="Vehiculo.Marca" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Vehiculo.Modelo" class="form-label">Modelo</label>
            <input asp-for="Vehiculo.Modelo" class="form-control" />
            <span asp-validation-for="Vehiculo.Modelo" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Vehiculo.Anio" class="form-label">Año</label>
                <input asp-for="Vehiculo.Anio" class="form-control" />
                <span asp-validation-for="Vehiculo.Anio" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Vehiculo.Capacidad" class="form-label">Capacidad (pasajeros)</label>
                <input asp-for="Vehiculo.Capacidad" class="form-control" />
                <span asp-validation-for="Vehiculo.Capacidad" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-4">
            <label asp-for="Vehiculo.Estado" class="form-label">Estado</label>
            <select asp-for="Vehiculo.Estado" class="form-select">
                <option value="disponible">Disponible</option>
                <option value="en_operacion">En operación</option>
                <option value="en_mantenimiento">En mantenimiento</option>
                <option value="fuera_de_servicio">Fuera de servicio</option>
                <option value="inactivo">Inactivo</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-page="/Vehiculos" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}