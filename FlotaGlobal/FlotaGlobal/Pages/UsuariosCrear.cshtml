@page
@model FlotaGlobal.Pages.UsuariosCrearModel
@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4 fw-bold">➕ Registrar Nuevo Usuario</h2>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

    <form method="post" class="card shadow-sm p-4 bg-white mb-5">
        <div class="mb-3">
            <label class="form-label fw-bold">Nombre Completo *</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej: Laura Gómez" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Correo Electrónico (Usuario de Login) *</label>
            <input asp-for="Correo" type="email" class="form-control" placeholder="laura.gomez@flotaglobal.com" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Contraseña *</label>
            <input asp-for="Contrasena" type="password" class="form-control" placeholder="••••••••" required />
        </div>

        <div class="row">
            <div class="col-md-7 mb-4">
                <label class="form-label fw-bold">Rol en el Sistema *</label>
                <select asp-for="IdRol" class="form-select" required>
                    <option value="">Seleccione un rol...</option>
                    @foreach (var r in Model.ListaRoles)
                    {
                        <option value="@r.IdRol">@r.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-5 mb-4">
                <label class="form-label fw-bold">Estado *</label>
                <select asp-for="Estado" class="form-select">
                    <option value="A">Activo</option>
                    <option value="I">Inactivo</option>
                </select>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end">
            <a asp-page="/Usuarios" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-dark px-4 fw-bold">Guardar Usuario</button>
        </div>
    </form>
</div>
