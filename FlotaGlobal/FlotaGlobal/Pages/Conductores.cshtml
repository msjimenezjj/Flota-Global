@page
@model FlotaGlobal.Pages.ConductoresModel
@{
    ViewData["Title"] = "Listado de Conductores";
}

<div class="container mt-4">
    <!-- Alerta verde de éxito cuando se registra o edita un conductor -->
    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            🔹 @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>👥 Gestión de Personal - Conductores Registrados</h2>
        <!-- Este botón redirigirá al formulario de registro real -->
        <a asp-page="/ConductoresCrear" class="btn btn-success fw-bold">+ Registrar Conductor</a>
    </div>

    @if (Model.Conductores == null || !Model.Conductores.Any())
    {
        <div class="alert alert-warning shadow-sm" role="alert">
            🚩 <strong>Atención:</strong> No se encontraron conductores registrados en el sistema de gestión actualmente o la tabla está vacía.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover m-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Documento</th>
                                <th>Nombre Completo</th>
                                <th>N° Licencia</th>
                                <th>Vencimiento</th>
                                <th>Teléfono</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var conductor in Model.Conductores)
                            {
                                <tr>
                                    <td class="fw-bold text-primary ps-3">@conductor.Documento</td>
                                    <td>@conductor.PrimerNombre @conductor.PrimerApellido</td>
                                    <td><code class="text-dark fw-bold">@conductor.Licencia</code></td>
                                    <td>@conductor.FechaVencimientoLicencia.ToString("dd/MM/yyyy")</td>
                                    <td>@conductor.Telefono</td>
                                    <td class="text-center">
                                        <span class="badge @ClaseEstado(conductor.Estado) px-3 py-2">
                                            @TextoEstado(conductor.Estado)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-page="/ConductoresEditar" asp-route-id="@conductor.IdConductor" class="btn btn-sm btn-outline-primary fw-bold px-3">Editar</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@functions {
    string ClaseEstado(string? estado) => estado?.Trim().ToUpper() switch
    {
        "A" => "bg-success text-white",
        "DISPONIBLE" => "bg-success text-white",
        "M" => "bg-warning text-dark",
        "INACTIVO" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    string TextoEstado(string? estado) => (estado?.Trim().ToUpper()) switch
    {
        "A" => "Activo",
        "M" => "Suspendido",
        _ => (estado ?? "sin estado").Replace("_", " ")
    };
}