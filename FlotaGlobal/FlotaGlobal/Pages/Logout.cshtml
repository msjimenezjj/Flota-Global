<!-- BLOQUE DINÁMICO DE AUTENTICACIÓN -->
<ul class="navbar-nav">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <li class="nav-item">
            <span class="nav-link text-primary fw-bold">👋 Hola, @User.Identity.Name</span>
        </li>
        <li class="nav-item">
            <a class="btn btn-outline-danger btn-sm my-1 px-3 fw-bold" asp-page="/Logout">Cerrar Sesión</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-primary btn-sm my-1 px-3 fw-bold" asp-page="/Login">Iniciar Sesión</a>
        </li>
    }
</ul>
