@page
@model FlotaGlobal.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<style>
    body {
        background: linear-gradient(rgba(15, 23, 42, 0.82), rgba(15, 23, 42, 0.82)), url('/images/fondo-flota.jpg') no-repeat center center fixed;
        background-size: cover;
    }

    .card-empresarial {
        background-color: rgba(255, 255, 255, 0.96) !important;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
    }
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card card-empresarial shadow-lg border-0" style="width: 100%; max-width: 440px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-primary">🔑 Recuperar Acceso</h3>
                <p class="text-muted small fw-bold">Ingrese su correo para validar su identidad</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alert alert-danger p-2 small shadow-sm" role="alert">
                    ⚠️ @Model.MensajeError
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.MensajeExito))
            {
                <div class="alert alert-success p-3 small shadow-sm" role="alert">
                    ✅ <strong>@Model.MensajeExito</strong>
                </div>
            }

            <form method="post">
                <div class="mb-4">
                    <label class="form-label small fw-bold text-dark">Correo Electrónico Registrado</label>
                    <input type="email" asp-for="Correo" class="form-control border-secondary" placeholder="ejemplo@empresa.com" required autofocus />
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-warning fw-bold py-2 shadow">Validar y Recuperar</button>
                    <a asp-page="/Login" class="btn btn-outline-secondary btn-sm fw-bold border-0 mt-1">Volver al Inicio de Sesión</a>
                </div>
            </form>
        </div>
    </div>
</div>
